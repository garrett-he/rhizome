{
    "name": "rhizome",
    "version": "0.1.0",
    "description": "A desktop application to create and manage personal knowledge base.",
    "keywords": [
        "documents",
        "knowledge-base",
        "llm",
        "mcp",
        "rag"
    ],
    "author": {
        "name": "Garrett HE",
        "email": "garrett.he@outlook.com"
    },
    "homepage": "https://github.com/garrett-he/rhizome#readme",
    "bugs": {
        "url": "https://github.com/garrett-he/rhizome/issues",
        "email": "garrett.he@outlook.com"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/garrett-he/rhizome.git"
    },
    "scripts": {
        "lint": "pnpm -C apps/desktop run lint",
        "lint:fix": "pnpm -C apps/desktop run lint:fix",
        "format": "pnpm -C apps/desktop run format",
        "typecheck": "pnpm -C apps/desktop run typecheck",
        "test": "pnpm -C apps/desktop run test",
        "test:coverage": "pnpm -C apps/desktop run test:coverage",
        "dev": "pnpm -C apps/desktop run tauri dev",
        "build": "pnpm -C apps/desktop run tauri build",
        "changeset": "changeset",
        "version": "changeset version",
        "prepare": "simple-git-hooks"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.0",
        "@changesets/cli": "^2.31.0",
        "lint-staged": "^17.0.7",
        "simple-git-hooks": "^2.13.1"
    },
    "engines": {
        "node": ">=22"
    },
    "private": true,
    "packageManager": "pnpm@11.6.0",
    "lint-staged": {
        "*": [
            "biome check --write --no-errors-on-unmatched"
        ]
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged"
    }
}
